<Window x:Class="DemCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DemCleaner.Models"
        mc:Ignorable="d"
        Title="DEM Cleaner - By Sipp Studio"
        Height="900" Width="1460"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBgWindow}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Default Dynamic Theme Brushes (Sage & Sandstone: Darker Tan Window Background + Rich Forest Green Panels) -->
        <SolidColorBrush x:Key="ThemeBgWindow" Color="#AD9168"/>
        <SolidColorBrush x:Key="ThemeBgCard" Color="#1E3326"/>
        <SolidColorBrush x:Key="ThemeBgWell" Color="#15241B"/>
        <SolidColorBrush x:Key="ThemeBgRowAlt" Color="#243D2E"/>
        <SolidColorBrush x:Key="ThemeBorderCard" Color="#3B5E49"/>
        <SolidColorBrush x:Key="ThemeBorderControl" Color="#8C6F48"/>
        <SolidColorBrush x:Key="ThemeTextPrimary" Color="#F0E6D2"/>
        <SolidColorBrush x:Key="ThemeTextSecondary" Color="#CDBB9E"/>
        <SolidColorBrush x:Key="ThemeTextMuted" Color="#96AA9B"/>
        <SolidColorBrush x:Key="ThemeAccentPrimary" Color="#C27D38"/>
        <SolidColorBrush x:Key="ThemeAccentPrimaryHover" Color="#A66726"/>
        <SolidColorBrush x:Key="ThemeAccentExport" Color="#529E66"/>
        <SolidColorBrush x:Key="ThemeAccentExportHover" Color="#3F8250"/>
        <SolidColorBrush x:Key="ThemeAccentDanger" Color="#D95B43"/>
        <SolidColorBrush x:Key="ThemeAccentWarning" Color="#E09B38"/>

        <!-- Stylish Theme-Matched ScrollBar Thumb & Track Templates -->
        <Style x:Key="StylishScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder"
                                Background="{DynamicResource ThemeAccentPrimary}"
                                CornerRadius="4"
                                Margin="1.5"
                                Opacity="0.85"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThemeAccentPrimaryHover}"/>
                                <Setter TargetName="thumbBorder" Property="Opacity" Value="1.0"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThemeAccentPrimaryHover}"/>
                                <Setter TargetName="thumbBorder" Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StylishScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{DynamicResource ThemeBgWell}"
                                BorderBrush="{DynamicResource ThemeBorderCard}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Margin="1">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource StylishScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource StylishScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource StylishScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Border Background="{DynamicResource ThemeBgWell}"
                                        BorderBrush="{DynamicResource ThemeBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Margin="1">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource StylishScrollBarPageButton}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource StylishScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource StylishScrollBarPageButton}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Border Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeBgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderCard}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentPrimary}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeBorderCard}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Export Button Style -->
        <Style x:Key="ExportButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentExport}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentExportHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeBorderCard}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger / Stop Processing Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentDanger}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeBorderCard}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row Remove Button Style -->
        <Style x:Key="RowRemoveButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBgWell}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentDanger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderControl}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentDanger}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBgWell}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderControl}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeBorderCard}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeBgCard}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeBgWell}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderControl}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccentPrimary}"/>
        </Style>

        <!-- Themed CheckBox & RadioButton -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3.5"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3.5"/>
        </Style>

        <!-- Themed ComboBox & Dropdown Menu Styles -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        Background="{DynamicResource ThemeBgWell}"
                        BorderBrush="{DynamicResource ThemeBorderControl}"
                        BorderThickness="1"
                        CornerRadius="5"/>
                <Border x:Name="ArrowWell"
                        Grid.Column="1"
                        Background="{DynamicResource ThemeBgCard}"
                        BorderBrush="{DynamicResource ThemeBorderControl}"
                        BorderThickness="1,0,0,0"
                        CornerRadius="0,4,4,0"
                        Margin="1"/>
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      Fill="{DynamicResource ThemeAccentPrimary}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4.5 5 L 9 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccentPrimary}"/>
                    <Setter TargetName="ArrowWell" Property="Background" Value="{DynamicResource ThemeBgRowAlt}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeTextPrimary}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccentPrimary}"/>
                    <Setter TargetName="ArrowWell" Property="Background" Value="{DynamicResource ThemeAccentPrimary}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Opacity" Value="0.55"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeTextMuted}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentPrimary}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeBgRowAlt}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentPrimaryHover}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,3,28,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Margin="0,3,0,6">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource ThemeBgCard}"
                                            BorderBrush="{DynamicResource ThemeAccentPrimary}"
                                            BorderThickness="1.5"
                                            CornerRadius="6"
                                            Padding="3">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed Slider with Rounded Pill Track & Circular Theme-Matched Knob -->
        <Style x:Key="SliderRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedSliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid>
                            <Ellipse x:Name="OuterKnob"
                                     Width="16" Height="16"
                                     Fill="{DynamicResource ThemeAccentPrimary}"
                                     Stroke="{DynamicResource ThemeTextPrimary}"
                                     StrokeThickness="1.8">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.45"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="InnerDot"
                                     Width="5" Height="5"
                                     Fill="{DynamicResource ThemeBgWell}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterKnob" Property="Fill" Value="{DynamicResource ThemeAccentPrimaryHover}"/>
                                <Setter TargetName="OuterKnob" Property="Stroke" Value="#FFFFFF"/>
                                <Setter TargetName="InnerDot" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="OuterKnob" Property="Fill" Value="{DynamicResource ThemeAccentExport}"/>
                                <Setter TargetName="OuterKnob" Property="Stroke" Value="#FFFFFF"/>
                                <Setter TargetName="InnerDot" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="TrackBackground"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ThemeBgCard}"
                                    BorderBrush="{DynamicResource ThemeBorderControl}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="4,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButtonStyle}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource RoundedSliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButtonStyle}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Theming for ToolTips-->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{DynamicResource ThemeBgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentPrimary}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <!-- Page Tab RadioButton Style (Used for Viewport Mode Tabs & Bottom Table Tabs) -->
        <Style x:Key="PageTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ThemeBgWell}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderCard}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="tabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="6,6,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="accentBar"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="1.5,1.5,0,0"
                                    Background="{DynamicResource ThemeBorderCard}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource ThemeBgRowAlt}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource ThemeBgCard}"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentPrimary}"/>
                                <Setter TargetName="tabBorder" Property="BorderThickness" Value="1.5,1.5,1.5,0"/>
                                <Setter TargetName="accentBar" Property="Background" Value="{DynamicResource ThemeAccentPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER: SIPP STUDIO BRANDING (WITH LICENSE.TXT TOOLTIP) & SETTINGS COG (Aligned with Left Options Panel) -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Width="375" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Title & Sipp Studio Credit (Hover for LICENSE.txt Tooltip) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DEM CLEANER" FontSize="17.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource ThemeBgWell}" BorderBrush="{DynamicResource ThemeBorderControl}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help"
                            ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                        <Border.ToolTip>
                            <ToolTip MaxWidth="720" Padding="16,14">
                                <TextBlock x:Name="TxtLicenseTooltip" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" xml:space="preserve">Loading license from LICENSE.txt...</TextBlock>
                            </ToolTip>
                        </Border.ToolTip>
                        <TextBlock Text="BY SIPP STUDIO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                    </Border>
                </StackPanel>

                <!-- Right Side of Left-Aligned Header: Settings Cog Wheel Button -->
                <Button x:Name="BtnToggleSettings" Grid.Column="1" Content="⚙" Style="{StaticResource SecondaryButton}"
                        FontSize="18" FontWeight="Bold" Width="34" Padding="0"
                        Click="BtnToggleSettings_Click"
                        ToolTip="Open Settings (Color Theme &amp; Map Provider)"/>
            </Grid>
        </Border>

        <!-- ANIMATED POPOUT SETTINGS PANEL (Canvas overlay ensures zero row expansion while animating over header & workspace) -->
        <Canvas Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1000">
            <Border x:Name="BdrSettingsPopout"
                    Canvas.Left="65" Canvas.Top="46" Width="310"
                    Visibility="Collapsed" Opacity="0"
                    Background="{DynamicResource ThemeBgCard}"
                    BorderBrush="{DynamicResource ThemeAccentPrimary}"
                    BorderThickness="1.5" CornerRadius="8" Padding="14,12"
                    RenderTransformOrigin="0.95,0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ScaleSettingsPopout" ScaleX="0.95" ScaleY="0.95"/>
                        <TranslateTransform x:Name="TransSettingsPopout" Y="-8"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.55"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚙ APPLICATION SETTINGS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" Click="BtnCloseSettings_Click" ToolTip="Close Settings"/>
                    </Grid>

                    <!-- Color Theme Selector -->
                    <Border Background="{DynamicResource ThemeBgWell}" CornerRadius="6" Padding="10,8" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="COLOR THEME" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbTheme" Height="27" SelectionChanged="CmbTheme_SelectionChanged" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Map Service Selection for Consolidated "Open in Map" Button -->
                    <Border Background="{DynamicResource ThemeBgWell}" CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="MAP PROVIDER (&quot;OPEN IN MAP&quot; BUTTON)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,4"/>
                            <RadioButton x:Name="RbMapProviderGoogleMaps" GroupName="MapProvider" Content="Google Maps" Checked="MapProvider_Changed"/>
                            <RadioButton x:Name="RbMapProviderGoogleEarth" GroupName="MapProvider" Content="Google Earth" IsChecked="True" Checked="MapProvider_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- MAIN WORKSPACE: LEFT SIDEBAR + RIGHT VISUAL PREVIEW -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="375"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SETTINGS & WORKFLOW PANELS -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. Import DEM Files (Consolidated Import TIFF Files / Folder Action + Clear All) -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="1. IMPORT DEM FILES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Import TIFF Files / Folder..." Style="{StaticResource PrimaryButton}" Click="BtnImportFiles_Click" Padding="10,6" ToolTip="Select one or more .tif/.tiff files, or navigate into a folder and click Open to import all TIFFs in that folder"/>
                                <Button Grid.Column="2" Content="Clear All" Style="{StaticResource SecondaryButton}" Click="BtnClear_Click" Padding="8,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. NoData / Empty Pixel Detection -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="2. EMPTY / NO DATA DETECTION" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkUseGdalNoData" Content="Auto-detect GDAL_NODATA tag &amp; NaN/Inf" IsChecked="True" Checked="DetectionSetting_Changed" Unchecked="DetectionSetting_Changed"/>
                            <CheckBox x:Name="ChkUseCustomThreshold" Content="Treat custom elevation threshold as empty:" IsChecked="True" Checked="DetectionSetting_Changed" Unchecked="DetectionSetting_Changed"/>

                            <Grid Margin="20,5,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbComparison" Grid.Column="0" SelectedIndex="0" SelectionChanged="DetectionSetting_Changed" Height="27">
                                    <ComboBoxItem Content="&lt;="/>
                                    <ComboBoxItem Content="=="/>
                                    <ComboBoxItem Content="&gt;="/>
                                </ComboBox>
                                <TextBox x:Name="TxtCustomNoData" Grid.Column="2" Text="-9999" LostFocus="TxtCustomNoData_LostFocus" KeyDown="TxtCustomNoData_KeyDown"/>
                            </Grid>
                            <TextBlock Text="Pixels matching these rules are excluded from Min/Max/Mean and filled." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Empty Area Fill Strategy (Default = Minimum Valid Elevation, Optional Per-Tile Override) -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="3. EMPTY DATA FILL &amp; SEAM SMOOTHING" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" Margin="0,0,0,6"/>

                            <RadioButton x:Name="RbFillMin" GroupName="FillMode" Content="Minimum Valid Elevation" IsChecked="True" Checked="FillSetting_Changed"/>
                            <RadioButton x:Name="RbFillMax" GroupName="FillMode" Content="Maximum Valid Elevation" Checked="FillSetting_Changed"/>
                            <RadioButton x:Name="RbFillMean" GroupName="FillMode" Content="Average Valid Elevation" Checked="FillSetting_Changed"/>
                            <RadioButton x:Name="RbFillInterpolated" GroupName="FillMode" Content="Interpolated" Checked="FillSetting_Changed"/>

                            <!-- Interpolated Sub-Options: Smoothing Passes (Default 10) & Warning Note (Only visible when Interpolated is selected) -->
                            <Border x:Name="BdrInterpolatedNote" Visibility="Collapsed" Background="{DynamicResource ThemeBgWell}" BorderBrush="{DynamicResource ThemeBorderControl}" BorderThickness="1" CornerRadius="5" Padding="9,7" Margin="20,3,0,4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="34"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Smoothing Passes:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider x:Name="SldIterations" Grid.Column="1" Minimum="1" Maximum="500" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldIterations_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ElementName=SldIterations, Path=Value, StringFormat={}{0:0}}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Note: Interpolation may take a very long time at high resolutions and passes."
                                                   FontSize="10.5" Foreground="{DynamicResource ThemeAccentWarning}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Sub-options for Global vs Per-Tile & Per-Tile Overrides -->
                            <Border Background="{DynamicResource ThemeBgWell}" CornerRadius="6" Padding="9" Margin="0,6,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="ChkUseGlobalForConstantFill" Content="Fill Value based on global data set (instead of per-tile)" IsChecked="True" Checked="FillSetting_Changed" Unchecked="FillSetting_Changed" ToolTip="When checked, Minimum/Maximum/Mean fill uses the entire grid's elevation stat rather than each individual tile's stat."/>
                                    <CheckBox x:Name="ChkEnablePerTileFillOverride" Content="Allow custom fill method per tile" Checked="ChkEnablePerTileFillOverride_Changed" Unchecked="ChkEnablePerTileFillOverride_Changed" ToolTip="Enable this to override the fill method for individual tiles while keeping the rest on the global default."/>
                                </StackPanel>
                            </Border>

                            <!-- Inter-Tile Seam Smoothing Option (Moved to Fill Method) -->
                            <Border Background="{DynamicResource ThemeBgWell}" CornerRadius="6" Padding="9,7" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tile Seam Smoothing" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}"/>
                                        <TextBlock x:Name="TxtSeamSmoothingStepsLabel" Grid.Column="1" Text="0 steps (Off)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentPrimary}"/>
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Steps:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider x:Name="SldSeamSmoothingSteps" Grid.Column="1" Minimum="0" Maximum="20" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldSeamSmoothingSteps_ValueChanged" VerticalAlignment="Center" ToolTip="Number of cross-boundary feathering and Laplacian smoothing passes applied between adjacent tiles in the grid"/>
                                        <Button x:Name="BtnApplySeamSmoothing" Grid.Column="3" Content="Apply" Style="{StaticResource SecondaryButton}" Padding="9,3" FontSize="11" Click="BtnApplySeamSmoothing_Click" ToolTip="Apply the selected number of seam smoothing steps across all adjacent tile borders"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnProcessAll" Content="Re-Calculate &amp; Fill All Tiles" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Padding="10,7" Click="BtnProcessAll_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Export Layout, Resolution and Format (Renumbered from 5) -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="4. EXPORT LAYOUT, RESOLUTION AND FORMAT" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" Margin="0,0,0,6"/>

                            <!-- Output Layout: Source Grid Size (Default), Single Merged Image (Below), Custom Grid Size -->
                            <Border Background="{DynamicResource ThemeBgWell}" CornerRadius="6" Padding="9,7" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="Output Layout" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,4"/>
                                    <RadioButton x:Name="RbExportSourceGrid" GroupName="NewExportLayout" Content="Source Grid Size (Matches loaded tiles)" IsChecked="True" Checked="NewExportLayout_Changed"/>
                                    <RadioButton x:Name="RbExportSingleImage" GroupName="NewExportLayout" Content="Single Merged Image (1 &#215; 1 file)" Checked="NewExportLayout_Changed"/>
                                    <RadioButton x:Name="RbExportCustomGrid" GroupName="NewExportLayout" Content="Custom Grid Size" Checked="NewExportLayout_Changed"/>

                                    <Grid x:Name="GrdNewExportCustomGrid" Margin="20,5,0,2" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Grid Size:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtNewExportGridSize" Grid.Column="1" Text="2" LostFocus="NewExportDimensions_Changed" KeyDown="NewExportDimensions_KeyDown" ToolTip="Splits the export area into an N × N grid of tiles"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Resolution of New Export Files -->
                            <Border Background="{DynamicResource ThemeBgWell}" CornerRadius="6" Padding="9,7" Margin="0,0,0,9">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Export Resolution" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbExportResolutionPresetSet" Grid.Column="2" Height="24" SelectedIndex="0" SelectionChanged="CmbExportResolutionPresetSet_SelectionChanged" VerticalContentAlignment="Center" ToolTip="Select resolution preset family (Power of Two, Unreal Engine Landscape sizes, or Unity Terrain heightmap sizes)">
                                            <ComboBoxItem Content="Power of Two"/>
                                            <ComboBoxItem Content="Unreal Engine (Landscape)"/>
                                            <ComboBoxItem Content="Unity (Terrain)"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Quick Resolution Presets (Above Custom Width & Height) -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="1.1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnResPreset0" Grid.Column="0" Content="Source" Style="{StaticResource PrimaryButton}" Padding="3,3" FontSize="10" Click="BtnPresetResolution_Click" Tag="Native" ToolTip="Set file resolution to exact 1:1 source pixels of the export area divided by the output grid"/>
                                        <Button x:Name="BtnResPreset1" Grid.Column="2" Content="1024" Style="{StaticResource SecondaryButton}" Padding="3,3" FontSize="10" Click="BtnPresetResolution_Click" Tag="1024"/>
                                        <Button x:Name="BtnResPreset2" Grid.Column="4" Content="2048" Style="{StaticResource SecondaryButton}" Padding="3,3" FontSize="10" Click="BtnPresetResolution_Click" Tag="2048"/>
                                        <Button x:Name="BtnResPreset3" Grid.Column="6" Content="4096" Style="{StaticResource SecondaryButton}" Padding="3,3" FontSize="10" Click="BtnPresetResolution_Click" Tag="4096"/>
                                        <Button x:Name="BtnResPreset4" Grid.Column="8" Content="8192" Style="{StaticResource SecondaryButton}" Padding="3,3" FontSize="10" Click="BtnPresetResolution_Click" Tag="8192"/>
                                        <Button x:Name="BtnResPreset5" Grid.Column="10" Content="16384" Style="{StaticResource SecondaryButton}" Padding="3,3" FontSize="9.5" Click="BtnPresetResolution_Click" Tag="16384" ToolTip="16384 &#215; 16384 px"/>
                                    </Grid>

                                    <!-- Custom Width & Height Fields + Quick Multiply / Divide by 2 Buttons -->
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="W:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtNewExportWidth" Grid.Column="1" Text="1024" LostFocus="TxtNewExportWidth_LostFocus" KeyDown="NewExportDimensions_KeyDown"/>
                                        <TextBlock Grid.Column="3" Text="H:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtNewExportHeight" Grid.Column="4" Text="1024" LostFocus="TxtNewExportHeight_LostFocus" KeyDown="NewExportDimensions_KeyDown"/>
                                        <Button x:Name="BtnDivideResolution" Grid.Column="6" Content="&#x00F7;2" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10.5" FontWeight="Bold" Click="BtnDivideResolution_Click" ToolTip="Divide custom Width and Height by 2"/>
                                        <Button x:Name="BtnMultiplyResolution" Grid.Column="8" Content="&#x00D7;2" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10.5" FontWeight="Bold" Click="BtnMultiplyResolution_Click" ToolTip="Multiply custom Width and Height by 2"/>
                                    </Grid>

                                    <CheckBox x:Name="ChkLockExportAspectRatio" Content="Lock aspect ratio to Export Area tile shape" IsChecked="False" Checked="ChkLockExportAspectRatio_Changed" Unchecked="ChkLockExportAspectRatio_Changed" ToolTip="When enabled, automatically adjusts the output Height (px) whenever Width (px) or Output Grid changes so each exported file preserves the exact width-to-height aspect ratio of its source tile region in the Export Area."/>
                                    <TextBlock x:Name="TxtNewExportResolutionSummary" Text="Output: 1 Single File &#x2022; 1024 &#215; 1024 px &#x2022; Ratio: 1.00&#215;" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentExport}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- File Format Selection Dropdown (16-Bit PNG Default + .TIFF Options) -->
                            <Border Background="{DynamicResource ThemeBgWell}" CornerRadius="6" Padding="9,7">
                                <StackPanel>
                                    <TextBlock Text="File Format" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbExportFileFormat" Height="27" SelectedIndex="0" SelectionChanged="CmbExportFileFormat_SelectionChanged" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="16-Bit Normalized PNG (.png — Default)" ToolTip="Exports 16-bit unsigned integer grayscale PNGs (0–65535) normalized across the global/active elevation range"/>
                                        <ComboBoxItem Content="32-Bit Float GeoTIFF (.tiff — Elevation in Meters)" ToolTip="Standard 32-bit IEEE float DEM .tiff with updated GeoTIFF coordinates &amp; pixel scale"/>
                                        <ComboBoxItem Content="16-Bit Normalized GeoTIFF (.tiff — 0–65535 Grayscale)" ToolTip="16-bit unsigned integer .tiff normalized to [0..1] across the elevation range"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 6. Export Folder (Bottom of Export Option Panels) -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="5. EXPORT FOLDER" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" Margin="0,0,0,6"/>

                            <!-- Designated Export Folder Selection & Open Folder Buttons -->
                            <TextBlock Text="Designated Export Folder:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtExportFolder" Text="" ToolTip="Designated folder where exported PNG and TIFF files will be saved" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="📁 Set Export Folder..." Style="{StaticResource SecondaryButton}" Click="BtnSetExportFolder_Click" ToolTip="Choose the destination folder for exported files"/>
                                <Button Grid.Column="2" Content="📂 Open Export Folder" Style="{StaticResource SecondaryButton}" Click="BtnOpenExportFolder_Click" ToolTip="Open the designated export folder in Windows Explorer"/>
                            </Grid>

                            <!-- Option to Rename Exported Files as Standard x0_y0, x1_y0, etc. (Default Checked) -->
                            <Border Background="{DynamicResource ThemeBgWell}" CornerRadius="6" Padding="9,7">
                                <StackPanel>
                                    <CheckBox x:Name="ChkExportStandardXyNaming" Content="Rename exported files as x0_y0, x1_y0, etc." IsChecked="True" Checked="ChkExportStandardXyNaming_Changed" Unchecked="ChkExportStandardXyNaming_Changed" ToolTip="When checked, exported tiles are named using their 0-based grid column (x) and row (y), e.g., x0_y0.png / x0_y0.tif. Note: This option is the standard format used by Gaea and Unreal Engine Tile Inputs."/>
                                    <Grid x:Name="GrdExportPrefixRow" Margin="20,4,0,2" Visibility="Visible">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Optional Prefix:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,8,0" FontSize="11.5"/>
                                        <TextBox x:Name="TxtExportPrefix" Grid.Column="1" Text="" ToolTip="Optional prefix before x0_y0 (leave blank for exact 'x0_y0', or e.g. 'tile_' for 'tile_x0_y0')"/>
                                    </Grid>
                                    <Grid x:Name="GrdExportSuffixRow" Margin="0,4,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Filename Suffix:" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,8,0" FontSize="11.5"/>
                                        <TextBox x:Name="TxtExportSuffix" Grid.Column="1" Text="_cleaned"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT PREVIEW & INSPECTOR AREA (Aligned Inline with Header Bar) -->
            <Grid Grid.Column="2" Margin="0,-46,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="215"/>
                </Grid.RowDefinitions>

                <!-- Viewport Mode Page Tabs & Quick Canvas Actions Bar -->
                <Grid Grid.Row="0" Panel.ZIndex="20" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Viewport Mode Page Tabs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <RadioButton x:Name="RbViewGrid" GroupName="PreviewTab" Content="Grid Layout" Style="{StaticResource PageTabButton}" IsChecked="True" Checked="PreviewMode_Changed"/>
                        <RadioButton x:Name="RbViewInspector" GroupName="PreviewTab" Content="Individual Tile Inspector" Style="{StaticResource PageTabButton}" Checked="PreviewMode_Changed"/>
                        <RadioButton x:Name="RbView3D" GroupName="PreviewTab" Content="3D Visualizer" Style="{StaticResource PageTabButton}" Checked="PreviewMode_Changed"/>
                    </StackPanel>

                    <!-- Right: Contextual Quick Tools (Highlight Voids, Selected Tile Fill, Center Res, Reset Area) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                        <!-- Selected Tile Per-Tile Fill Method Selector (Visible when Per-Tile Override is enabled) -->
                        <StackPanel x:Name="PnlSelectedTileOverride" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Selected Fill:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentPrimary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="CmbSelectedTileFillOverride" Width="112" Height="23" SelectionChanged="CmbSelectedTileFillOverride_SelectionChanged" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Use Global Default"/>
                                <ComboBoxItem Content="Minimum"/>
                                <ComboBoxItem Content="Maximum"/>
                                <ComboBoxItem Content="Mean"/>
                                <ComboBoxItem Content="Interpolated"/>
                            </ComboBox>
                        </StackPanel>

                        <CheckBox x:Name="ChkHighlightVoidsInRed" Content="Highlight Voids" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentDanger}" IsChecked="False" Checked="PreviewLayer_Changed" Unchecked="PreviewLayer_Changed" ToolTip="When checked, displays raw input elevation data with empty/NoData void pixels highlighted in red" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="BtnCenterExportAreaToolbar" Content="◎ Center Res" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="10.5" Margin="0,0,5,0" Click="BtnCenterExportArea_Click" IsEnabled="False" ToolTip="Create a custom export region at the center of the grid sized to the selected export resolution in source data pixels"/>
                        <Button x:Name="BtnResetExportAreaToolbar" Content="↺ Reset Area" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="10.5" Click="BtnResetExportArea_Click" IsEnabled="False" ToolTip="Reset custom export area back to full global DEM grid"/>
                    </StackPanel>
                </Grid>

                <!-- VISUAL CANVAS: FULL-BLEED VIEWPORT WITH STATIONARY TOP TELEMETRY RIBBON -->
                <Border x:Name="BdrViewportCard" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,10" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- DOCKED TOP TELEMETRY RIBBON (Stationary HUD above canvas, never obscures mosaic) -->
                        <Border Grid.Row="0" Background="{DynamicResource ThemeBgWell}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="0,0,0,1" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Dataset Metrics (Tiles, Voids, Elevation ΔZ) -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Tiles & Voids Pill -->
                                    <Border Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="4" Padding="6,2.5" Margin="0,0,6,0" ToolTip="Loaded DEM tiles count and void pixel total">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="TILES:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock x:Name="TxtTileCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="VOIDS:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentDanger}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock x:Name="TxtTotalVoids" Text="0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Elevation Extents & ΔZ Pill -->
                                    <Border Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="4" Padding="6,2.5" Margin="0,0,6,0" ToolTip="Elevation range [Min, Max] and relief height difference (ΔZ)">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="ELEV:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock x:Name="TxtGlobalMin" Text="—" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" → " FontSize="9.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtGlobalMax" Text="—" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="ΔZ: " FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentWarning}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtGlobalHeightRange" Text="—" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Center: Ground Span & Ground Resolution Scale -->
                                <Border Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="4" Padding="8,2.5" ToolTip="Physical ground dimensions and meters per pixel scale of current grid or export area">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtGridSizeLabel" Text="SPAN:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentExport}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtGlobalGridWidth" Text="—" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtMetersPerPixelLabel" Text="SCALE:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtSourceMetersPerPixel" Text="—" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Right: Geolocation & Open in Map Button -->
                                <Border Grid.Column="2" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="4" Padding="6,2" ToolTip="Georeferenced center coordinates of loaded DEM tiles">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📍 " FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtGridCenterCoords" Text="No georeferenced tiles loaded" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                        <Button x:Name="BtnOpenInMap" Content="🌐 Open in Map" Style="{StaticResource SecondaryButton}" Padding="6,1.5" FontSize="9.5" Click="BtnOpenInMap_Click" IsEnabled="False" ToolTip="Opens the center coordinates of the DEM grid in Google Maps or Google Earth (configured in Settings ⚙)"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Main Preview Canvas Area (Row 1: Full-Bleed Viewport Space) -->
                        <Grid Grid.Row="1" Panel.ZIndex="0">
                            <!-- Empty State Prompt -->
                            <StackPanel x:Name="PnlEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeBgWell}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="5" ToolTip="Physical width × height of the global grid or active custom export area using the Meters/Pixel scale" Padding="6,2,6,6">
                                    <TextBlock Text="Drop DEM .tif / .tiff files here" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Hidden Legacy Overlay Hook to safely preserve C# bindings -->
                            <Border x:Name="BdrGridLeftStatsOverlay" Visibility="Collapsed" IsHitTestVisible="False"/>

                            <!-- 2D Grid Layout View with Overlaid Axis Legend (Full Canvas Viewport with Clean 16px Padding) -->
                            <ScrollViewer x:Name="SvGridMosaic" Visibility="Collapsed" 
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                                          Padding="16,12"
                                          PreviewMouseWheel="SvGridMosaic_PreviewMouseWheel"
                                          PreviewMouseDown="SvGridMosaic_PreviewMouseDown"
                                          PreviewMouseMove="SvGridMosaic_PreviewMouseMove"
                                          PreviewMouseUp="SvGridMosaic_PreviewMouseUp">
                                <Grid MinWidth="{Binding ElementName=SvGridMosaic, Path=ViewportWidth}"
                                      MinHeight="{Binding ElementName=SvGridMosaic, Path=ViewportHeight}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid x:Name="GrdMosaicWithHeaders" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0">
                                        <Grid.LayoutTransform>
                                            <ScaleTransform x:Name="ScaleGridMosaic" ScaleX="1.0" ScaleY="1.0"/>
                                        </Grid.LayoutTransform>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>

                            <!-- 2D Viewport Scale Line Overlay (Bottom-Left of 2D Grid Layout, Overlaid on Grid) -->
                            <Border x:Name="Bdr2DScaleBar" Panel.ZIndex="25" Visibility="Collapsed" Background="#D8141E18" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <StackPanel>
                                    <TextBlock x:Name="Txt2DScaleBarLabel" Text="1.0 km" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="2" Height="8" Fill="{DynamicResource ThemeAccentPrimary}" VerticalAlignment="Center"/>
                                        <Rectangle x:Name="Rect2DScaleLine" Grid.Column="1" Width="90" Height="2.5" Fill="{DynamicResource ThemeAccentPrimary}" VerticalAlignment="Center"/>
                                        <Rectangle Grid.Column="2" Width="2" Height="8" Fill="{DynamicResource ThemeAccentPrimary}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="Txt2DScaleTotalSpan" Text="Grid Span: —" FontSize="9.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Individual Tile Before / After Side-by-Side Inspector (Expanded Full Canvas Width) -->
                            <Grid x:Name="GrdTileInspector" Visibility="Collapsed" Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource ThemeBgWell}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="BEFORE: RAW DEM (EMPTY / NODATA AREAS IN RED)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentDanger}" Margin="0,0,0,8"/>
                                        <Image x:Name="ImgInspectorRaw" Grid.Row="1" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource ThemeBgWell}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="TxtInspectorAfterHeader" Text="AFTER: FILLED &amp; NORMALIZED TO GLOBAL [0, 1] RANGE" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentExport}" Margin="0,0,0,8"/>
                                        <Image x:Name="ImgInspectorProcessed" Grid.Row="1" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 3D GPU Heightmap Visualizer (Zero Padding / Maximum View Size) -->
                            <Border x:Name="Grd3DVisualizer" Visibility="Collapsed" Background="#101813" BorderThickness="0" Padding="0" Margin="0" ClipToBounds="True" Cursor="SizeAll"
                                    MouseDown="Grd3DVisualizer_MouseDown"
                                    MouseMove="Grd3DVisualizer_MouseMove"
                                    MouseUp="Grd3DVisualizer_MouseUp"
                                    MouseWheel="Grd3DVisualizer_MouseWheel">
                                <Grid>
                                    <Viewport3D x:Name="Vp3DHeightmap" ClipToBounds="True" IsHitTestVisible="False">
                                        <Viewport3D.Camera>
                                            <PerspectiveCamera x:Name="Cam3D" Position="0,1.65,2.25" LookDirection="0,-1.45,-2.25" UpDirection="0,1,0" FieldOfView="44" NearPlaneDistance="0.05" FarPlaneDistance="50"/>
                                        </Viewport3D.Camera>
                                        <ModelVisual3D>
                                            <ModelVisual3D.Content>
                                                <Model3DGroup>
                                                    <AmbientLight Color="#565E58"/>
                                                    <DirectionalLight x:Name="Light3DMain" Color="#FFF9EC" Direction="-0.58,-0.76,-0.52"/>
                                                    <DirectionalLight x:Name="Light3DFill" Color="#324450" Direction="0.55,0.35,0.55"/>

                                                    <!-- Displaced 3D Terrain Surface Model -->
                                                    <GeometryModel3D x:Name="Model3DTerrain">
                                                        <GeometryModel3D.Transform>
                                                            <ScaleTransform3D x:Name="Scale3DTerrain" ScaleX="1" ScaleY="0.2" ScaleZ="1"/>
                                                        </GeometryModel3D.Transform>
                                                    </GeometryModel3D>

                                                    <!-- Solid Geological Base Skirt Model -->
                                                    <GeometryModel3D x:Name="Model3DSkirt">
                                                        <GeometryModel3D.Material>
                                                            <DiffuseMaterial>
                                                                <DiffuseMaterial.Brush>
                                                                    <SolidColorBrush Color="#2B241D"/>
                                                                </DiffuseMaterial.Brush>
                                                            </DiffuseMaterial>
                                                        </GeometryModel3D.Material>
                                                        <GeometryModel3D.BackMaterial>
                                                            <DiffuseMaterial>
                                                                <DiffuseMaterial.Brush>
                                                                    <SolidColorBrush Color="#2B241D"/>
                                                                </DiffuseMaterial.Brush>
                                                            </DiffuseMaterial>
                                                        </GeometryModel3D.BackMaterial>
                                                        <GeometryModel3D.Transform>
                                                            <ScaleTransform3D x:Name="Scale3DSkirt" ScaleX="1" ScaleY="0.2" ScaleZ="1"/>
                                                        </GeometryModel3D.Transform>
                                                    </GeometryModel3D>
                                                </Model3DGroup>
                                            </ModelVisual3D.Content>
                                        </ModelVisual3D>
                                    </Viewport3D>

                                    <!-- Top-Left "Return to Global Grid" Button (Appears in 3D Viewport when viewing a smaller custom selection cropped in Grid Layout) -->
                                    <Button x:Name="Btn3DReturnToGlobal" Visibility="Collapsed" Content="↺ Return to Global Grid" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BtnResetExportArea_Click" ToolTip="Reset the custom cropped selection back to the full global DEM grid"/>

                                    <!-- Bottom-Left 3D Viewport Scale Line Overlay -->
                                    <Border x:Name="Bdr3DScaleBar" Background="#D8141E18" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <StackPanel>
                                            <TextBlock x:Name="Txt3DScaleBarLabel" Text="1.0 km" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="2" Height="8" Fill="{DynamicResource ThemeAccentPrimary}" VerticalAlignment="Center"/>
                                                <Rectangle x:Name="Rect3DScaleLine" Grid.Column="1" Width="90" Height="2.5" Fill="{DynamicResource ThemeAccentPrimary}" VerticalAlignment="Center"/>
                                                <Rectangle Grid.Column="2" Width="2" Height="8" Fill="{DynamicResource ThemeAccentPrimary}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock x:Name="Txt3DScaleTotalSpan" Text="Zone Span: —" FontSize="9.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bottom-Right GPU 3D Heightmap Stats & Controls Badge -->
                                    <Border Background="#D8141E18" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <StackPanel>
                                            <TextBlock x:Name="Txt3DGpuHudTitle" Text="GPU 3D HEIGHTMAP • 2K (2048 × 2048)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="Txt3DGpuHudSub" Text="Left-Drag: Orbit • Right/Middle-Drag: Pan • Scroll Wheel: Zoom" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Top-Right 3D Visualizer Options Card (Only visible inside 3D Viewport) -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Width="184" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1.2" CornerRadius="6" Padding="8,7" Opacity="0.95">
                                        <StackPanel x:Name="PnlViewport3DBar" Visibility="Collapsed">
                                            <TextBlock Text="3D VISUALIZER OPTIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" Margin="0,0,0,4"/>
                                            <CheckBox x:Name="Chk3DSimulateWater" Content="Simulate Water" FontSize="11" IsChecked="True" Checked="Preview3DOption_Changed" Unchecked="Preview3DOption_Changed" ToolTip="Shades large, low-elevation flat terrain regions with water blue colors"/>

                                            <!-- Water Shader Slope Limit & Altitude Limit Sliders -->
                                            <Border x:Name="Bdr3DWaterSliders" Background="{DynamicResource ThemeBgWell}" CornerRadius="5" Padding="7,5" Margin="0,3,0,5">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Water Slope Limit:" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                        <TextBlock x:Name="Txt3DWaterSlopeLabel" Grid.Column="1" Text="0.12m" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}"/>
                                                    </Grid>
                                                    <Slider x:Name="Sld3DWaterSlopeLimit" Minimum="0.01" Maximum="1.50" Value="0.12" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="Sld3DWaterParam_ValueChanged" Margin="0,0,0,5" ToolTip="Maximum elevation variation (meters) across neighborhood rings to classify terrain as flat water"/>

                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Water Altitude Limit:" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                        <TextBlock x:Name="Txt3DWaterAltitudeLabel" Grid.Column="1" Text="24%" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}"/>
                                                    </Grid>
                                                    <Slider x:Name="Sld3DWaterAltitudeLimit" Minimum="1" Maximum="100" Value="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Sld3DWaterParam_ValueChanged" ToolTip="Maximum normalized altitude percentage (0–100% of height range) where water can appear"/>
                                                </StackPanel>
                                            </Border>

                                            <CheckBox x:Name="Chk3DHighlightQuadEdges" Content="Highlight Quad Edges" FontSize="11" IsChecked="False" Checked="Preview3DOption_Changed" Unchecked="Preview3DOption_Changed" ToolTip="Highlights the 3D terrain mesh quad edges across the surface"/>

                                            <TextBlock Text="3D Resolution:" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,3"/>
                                            <ComboBox x:Name="Cmb3DResolution" Height="24" SelectedIndex="1" SelectionChanged="Cmb3DResolution_SelectionChanged" VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="1K (1024 × 1024)"/>
                                                <ComboBoxItem Content="2K (2048 × 2048)"/>
                                                <ComboBoxItem Content="4K (4096 × 4096)"/>
                                                <ComboBoxItem Content="8K (8192 × 8192)"/>
                                                <ComboBoxItem Content="16K (16384 × 16384)"/>
                                            </ComboBox>

                                            <TextBlock Text="Shading Palette:" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,7,0,3"/>
                                            <ComboBox x:Name="Cmb3DShading" Height="24" SelectedIndex="0" SelectionChanged="Cmb3DShading_SelectionChanged" VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="Hypsometric Topo"/>
                                                <ComboBoxItem Content="Grayscale (0–1)"/>
                                                <ComboBoxItem Content="Alpine Glacier"/>
                                                <ComboBoxItem Content="Desert Canyon"/>
                                            </ComboBox>

                                            <TextBlock Text="Z-Scale (Height / Width):" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,7,0,3"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="Txt3DZScaleRatio" Grid.Column="0" Height="24" Text="0.200" Padding="6,2" LostFocus="Txt3DZScaleRatio_LostFocus" KeyDown="Txt3DZScaleRatio_KeyDown" ToolTip="Height-to-Width ratio (ΔZ / Width) of the 3D terrain"/>
                                                <Button Grid.Column="2" Content="Auto" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10.5" Click="BtnAuto3DZScale_Click" ToolTip="Automatically derive Z-Scale from active global or selected zone dimensions"/>
                                            </Grid>

                                            <Grid Margin="0,8,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Sun Angle:" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Slider x:Name="Sld3DSunAzimuth" Grid.Column="1" Minimum="0" Maximum="360" Value="135" ValueChanged="Sld3DSunAzimuth_ValueChanged" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Button Content="↺ Reset 3D Camera" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Click="BtnReset3DCamera_Click" ToolTip="Reset 3D camera orbit, pan, and zoom"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Loading Indicator Overlay when building GPU Texture -->
                                    <Border x:Name="Bdr3DLoadingOverlay" Visibility="Collapsed" Background="#B8101813" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,10" BorderBrush="{DynamicResource ThemeAccentPrimary}" BorderThickness="1.5" IsHitTestVisible="False">
                                        <TextBlock x:Name="Txt3DLoadingMessage" Text="Building GPU 3D Heightmap..." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- BOTTOM DATA TABLES: TAB 1 = LOADED DEM TILES, TAB 2 = EXPECTED OUTPUT FILES, TAB 3 = DYNAMIC SCALE & FIDELITY MATRIX -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Three-Tab Page Tabs Header Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource PageTabButton}" x:Name="RbTabLoadedTiles" IsChecked="True" GroupName="BottomTableTabs" Content="LOADED DEM TILES" Checked="BottomTableTab_Changed" Height="26"/>
                                <RadioButton x:Name="RbTabExpectedOutputs" GroupName="BottomTableTabs" Content="EXPECTED OUTPUT FILES" Style="{StaticResource PageTabButton}" Checked="BottomTableTab_Changed" Height="26"/>
                                <RadioButton x:Name="RbTabScaleMatrix" GroupName="BottomTableTabs" Content="DYNAMIC SCALE &amp; FIDELITY MATRIX" Style="{StaticResource PageTabButton}" Checked="BottomTableTab_Changed" Height="26"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtBottomTableHint" Grid.Column="2" Text="Use '✕' to remove a tile • Click a row to inspect" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Tab 1: Loaded DEM Tiles Table (Reordered Columns) -->
                        <DataGrid x:Name="DgTiles" Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionChanged="DgTiles_SelectionChanged"
                                  CellEditEnding="DgTiles_CellEditEnding"
                                  Background="{DynamicResource ThemeBgWell}"
                                  RowBackground="{DynamicResource ThemeBgCard}"
                                  AlternatingRowBackground="{DynamicResource ThemeBgRowAlt}"
                                  Foreground="{DynamicResource ThemeTextPrimary}"
                                  BorderBrush="{DynamicResource ThemeBorderCard}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource ThemeBorderCard}"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="{DynamicResource ThemeBgWell}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderCard}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Padding" Value="6,3"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentPrimary}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="32">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" MinWidth="5">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource RowRemoveButton}" Click="BtnRemoveSingleTile_Click" Tag="{Binding}" ToolTip="Remove this tile from the grid and recalculate global range"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Requested Order: File Name, Status, Tile Fill Method (if enabled), Empty %, Elev Range, Tile Min, Tile Max, Size, Global X, Grid Col, Global Y, Grid Row -->
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" IsReadOnly="True" Width="230"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="170"/>

                                <DataGridTemplateColumn x:Name="ColTileFillOverride" Header="Tile Fill Method" Width="138" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{x:Static models:DemTile.AvailableFillOverrides}"
                                                      SelectedItem="{Binding FillOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectionChanged="RowFillOverrideCombo_SelectionChanged"
                                                      Tag="{Binding}"
                                                      Height="22"
                                                      FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Empty %" Binding="{Binding VoidPercentage, StringFormat=\{0:F2\}%}" IsReadOnly="True" Width="68"/>
                                <DataGridTextColumn Header="Elev Range" Binding="{Binding ElevationRange, StringFormat=\{0:F2\}}" IsReadOnly="True" Width="82"/>
                                <DataGridTextColumn Header="Tile Min" Binding="{Binding MinElevation, StringFormat=\{0:F2\}}" IsReadOnly="True" Width="78"/>
                                <DataGridTextColumn Header="Tile Max" Binding="{Binding MaxElevation, StringFormat=\{0:F2\}}" IsReadOnly="True" Width="78"/>
                                <DataGridTextColumn Header="Global X" Binding="{Binding ColCoordinateLabel}" IsReadOnly="True" Width="76"/>
                                <DataGridTextColumn Header="Global Y" Binding="{Binding RowCoordinateLabel}" IsReadOnly="True" Width="76"/>
                                <DataGridTextColumn Header="Grid Col" Binding="{Binding GridCol, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                                <DataGridTextColumn Header="Grid Row" Binding="{Binding GridRow, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Tab 2: Expected Output Files Table -->
                        <DataGrid x:Name="DgExpectedOutputs" Grid.Row="1"
                                  Visibility="Collapsed"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Background="{DynamicResource ThemeBgWell}"
                                  RowBackground="{DynamicResource ThemeBgCard}"
                                  AlternatingRowBackground="{DynamicResource ThemeBgRowAlt}"
                                  Foreground="{DynamicResource ThemeTextPrimary}"
                                  BorderBrush="{DynamicResource ThemeBorderCard}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource ThemeBorderCard}"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="{DynamicResource ThemeBgWell}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderCard}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Padding" Value="6,3"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ThemeAccentPrimary}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="32">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Output File Name" Binding="{Binding OutputFileName}" Width="175"/>
                                <DataGridTextColumn Header="Grid Slot" Binding="{Binding GridSlotLabel}" Width="95"/>
                                <DataGridTextColumn Header="File Format" Binding="{Binding FormatDescription}" Width="145"/>
                                <DataGridTextColumn Header="Output Resolution" Binding="{Binding OutputResolutionLabel}" Width="118"/>
                                <DataGridTextColumn Header="Source Area (px)" Binding="{Binding SourceAreaPixelsLabel}" Width="115"/>
                                <DataGridTextColumn Header="Export / Source Ratio" Binding="{Binding ResolutionRatioLabel}" Width="125"/>
                                <DataGridTextColumn Header="Physical Size" Binding="{Binding PhysicalSizeLabel}" Width="115"/>
                                <DataGridTextColumn Header="Elev Range" Binding="{Binding SubElevationRange, StringFormat=\{0:F2\}m}" Width="82"/>
                                <DataGridTextColumn Header="Min Elev" Binding="{Binding SubMinElevation, StringFormat=\{0:F2\}m}" Width="78"/>
                                <DataGridTextColumn Header="Max Elev" Binding="{Binding SubMaxElevation, StringFormat=\{0:F2\}m}" Width="78"/>
                                <DataGridTextColumn Header="Est. Size" Binding="{Binding EstimatedFileSizeLabel}" Width="78"/>
                                <DataGridTextColumn Header="Destination Path" Binding="{Binding FullOutputPath}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Tab 3: Dynamic Scale & Fidelity Matrix Panel -->
                        <Border x:Name="PnlScaleMatrix" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource ThemeBgWell}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Top 5 Dynamic Pillars -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="1.25*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pillar 1: Export Region Physical Span -->
                                    <Border Grid.Column="0" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="5" Padding="9,6">
                                        <StackPanel>
                                            <TextBlock Text="1. REGION GROUND SPAN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentExport}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtMatrixRegionSpanKm" Text="—" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                            <TextBlock x:Name="TxtMatrixRegionSpanMeters" Text="—" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="TxtMatrixRegionType" Text="Full Global Mosaic" FontSize="9" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pillar 2: Export Resolution & Layout -->
                                    <Border Grid.Column="2" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="5" Padding="9,6">
                                        <StackPanel>
                                            <TextBlock Text="2. EXPORT RESOLUTION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentPrimary}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtMatrixTotalPixels" Text="—" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                            <TextBlock x:Name="TxtMatrixPerTileResolution" Text="—" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="TxtMatrixOutputLayout" Text="1 Single Merged File" FontSize="9" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pillar 3: Ground Scale (Meters Per Pixel) -->
                                    <Border Grid.Column="4" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="5" Padding="9,6">
                                        <StackPanel>
                                            <TextBlock Text="3. GROUND RESOLUTION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentWarning}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtMatrixGroundScaleMpp" Text="—" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                            <TextBlock x:Name="TxtMatrixSourceScaleMpp" Text="Source DEM: —" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,1,0,0"/>
                                            <TextBlock Text="Engine Quad / Grid Step" FontSize="9" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pillar 4: Format & Storage Estimates -->
                                    <Border Grid.Column="6" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="5" Padding="9,6">
                                        <StackPanel>
                                            <TextBlock Text="4. ESTIMATED STORAGE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtMatrixEstFileSize" Text="—" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                            <TextBlock x:Name="TxtMatrixFormatDesc" Text="16-Bit Norm PNG" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="TxtMatrixBatchSummary" Text="Total Files: 1" FontSize="9" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pillar 5: Human Reference & Pixel Step Scale -->
                                    <Border Grid.Column="8" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="5" Padding="8,5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0" Margin="0,0,0,3">
                                                <TextBlock Text="5. HUMAN GROUND SCALE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentExport}" DockPanel.Dock="Left"/>
                                                <TextBlock x:Name="TxtMatrixHumanRatio" Text="1 Step = —" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentWarning}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                            </DockPanel>

                                            <!-- Scaled Human & Pixel Step Canvas -->
                                            <Border Grid.Row="1" Background="{DynamicResource ThemeBgWell}" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="0.8" ClipToBounds="True" MinHeight="44">
                                                <Canvas x:Name="CnvHumanScaleReference" ClipToBounds="True" SizeChanged="CnvHumanScaleReference_SizeChanged"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Bottom Dynamic Fidelity Ratio Gauge & Explanation Bar -->
                                <Border Grid.Row="1" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1" CornerRadius="5" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BdrMatrixFidelityBadge" Grid.Column="0" Background="{DynamicResource ThemeAccentExport}" CornerRadius="4" Padding="9,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtMatrixFidelityRatio" Text="1.00× (1:1 PARITY)" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtMatrixFidelityTitle" Text="NATIVE PIXEL-TO-METER FIDELITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                            <TextBlock x:Name="TxtMatrixFidelityDesc" Text="Export resolution matches source data pixel density. Zero geometric blurring or artificial interpolation." FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="VERTICAL RELIEF (ΔZ):" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="TxtMatrixElevationRange" Text="—" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentWarning}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER STATUS BAR, SINGLE EXPORT BUTTON, STOP BUTTON & ANIMATED PROGRESS -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderCard}" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnExportMain" Grid.Column="0" Content="EXPORT FILES" Style="{StaticResource ExportButton}" FontSize="14" FontWeight="Bold" Padding="20,7" Margin="0,0,8,0" Click="BtnExportMain_Click" ToolTip="Export the defined Export Area using the configured Output Layout, Resolution, File Format, and Export Folder"/>
                <Button x:Name="BtnStopMain" Grid.Column="1" Content="&#x25A0; STOP" Style="{StaticResource DangerButton}" FontSize="13" FontWeight="Bold" Padding="16,7" Margin="0,0,14,0" Click="BtnStopProcessing_Click" IsEnabled="False" ToolTip="Cancel ongoing calculation or export process"/>
                <TextBlock x:Name="TxtStatusBar" Grid.Column="2" Text="Ready. Import DEM .tiff files or drag and drop a folder into the window." FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="PbProgress" Grid.Column="3" Height="18" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource ThemeBgWell}" Foreground="{DynamicResource ThemeAccentPrimary}" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderCard}" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
